# Copy to backend/.env and adjust. Every value here is optional: the app boots
# with safe defaults so a fresh clone runs without any .env at all.
# (Full env surface is specified in BE-30.)

# --- Service -----------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS --------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Cache -------------------------------------------------------------------
# locmem | redis
CACHE_BACKEND=locmem
REDIS_URL=redis://localhost:6379/0
WEATHER_CACHE_TTL_SECONDS=21600
ANALYSIS_CACHE_TTL_SECONDS=900

# --- Upstream providers ------------------------------------------------------
GEOCODER_PROVIDER=open_meteo
ROUTING_PROVIDER=osrm
# open_meteo | mock   (mock = deterministic synthetic storm, used by CI and the demo)
WEATHER_PROVIDER=open_meteo

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=30

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_SECONDS=45
HTTP_MAX_RETRIES=3

# --- Domain tuning (documented in docs/DECISIONS.md) ------------------------
SAMPLE_SPACINGS_MILES=10,25,50
DEFAULT_SAMPLE_SPACING_MILES=25
SLIDER_MAX_OFFSET_HOURS=48
TRUCK_SPEED_FACTOR=0.85
TRUCK_MIN_AVG_MPH=25
TRUCK_MAX_AVG_MPH=65
SAFETY_GATE_ENABLED=true
LOAD_BOUNDARY_INCLUSIVE=false
CHECKPOINT_TIME_SNAP=floor
WEATHER_LOCATION_BUDGET=90
WEATHER_BATCH_SIZE=20
